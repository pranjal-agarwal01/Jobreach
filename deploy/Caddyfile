# One address for everything: the web app, and the API under /api. Installed by setup.sh as
# /etc/caddy/Caddyfile, with __DOMAIN__ replaced by SITE_DOMAIN. Caddy obtains the HTTPS
# certificate on first start (ports 80 and 443 open, and the domain's A record pointing here).
__DOMAIN__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# The API: /api/health -> 127.0.0.1:8000/health. Uploads (CVs) can be a few MB.
	handle_path /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
