[Unit]
Description=Jobreach API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__BASE__/src/backend
EnvironmentFile=__BASE__/.env
Environment=HOME=__BASE__/home PYTHONUNBUFFERED=1
ExecStart=__BASE__/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
