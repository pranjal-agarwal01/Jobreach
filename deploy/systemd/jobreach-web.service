[Unit]
Description=Jobreach web app (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__BASE__/src/frontend/.next/standalone
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1 NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/node/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
