# Copy to backend/.env and fill in. Never commit backend/.env.

# Supabase -> Connect -> Session pooler (IPv4). Includes the database password.
DATABASE_URL=postgresql://postgres.pksaqwmgibkuyydlwdfb:<db-password>@<pooler-host>:5432/postgres

# Not secret
SUPABASE_URL=https://pksaqwmgibkuyydlwdfb.supabase.co
CORS_ORIGINS=http://localhost:3000
# Where this API is reachable from outside; resume share links point here.
PUBLIC_BASE_URL=http://localhost:8000
# Optional: raises the GitHub API limit for reading students' public repos (60/hour without).
# GITHUB_TOKEN=

# ---- Model provider: pick one ------------------------------------------------------------

# Azure OpenAI (works in UAE North). Deploy "gpt-6.1-sol" and "gpt-6-luna" (Global Standard)
# in your Foundry resource; LLM_MODEL / LLM_MODEL_FAST are the deployment names.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-sol
LLM_MODEL_FAST=gpt-6-luna

# Claude API
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# Claude on Microsoft Foundry (needs a resource in a region that offers Claude, e.g. Sweden
# Central or East US 2, and a paid pay-as-you-go subscription)
# LLM_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_RESOURCE=<resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# CLAUDE_FALLBACK_MODEL=<optional second deployment, retried if a request is refused>
