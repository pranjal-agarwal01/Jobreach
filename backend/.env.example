# Copy to backend/.env and fill in. Never commit backend/.env.

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Supabase -> Connect -> Session pooler (IPv4). Includes the database password.
DATABASE_URL=

# Not secret
SUPABASE_URL=https://pksaqwmgibkuyydlwdfb.supabase.co
CLAUDE_MODEL=claude-sonnet-5-5
CORS_ORIGINS=http://localhost:3000

# Optional: Claude through Microsoft Foundry instead of the Claude API.
# CLAUDE_MODEL then names your Foundry deployment (deploy "claude-sonnet-5-5", Hosted on Azure).
# The resource name is the first part of your project endpoint:
#   https://<resource-name>.services.ai.azure.com/api/projects/<project>
# CLAUDE_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_RESOURCE=<resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=
# CLAUDE_FALLBACK_MODEL=<optional second deployment, e.g. claude-sonnet-5, retried if a request is refused>
