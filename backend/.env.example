# Copy to backend/.env and fill in. Never commit backend/.env.

# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Supabase -> Connect -> Session pooler (IPv4). Includes the database password.
DATABASE_URL=

# Not secret
SUPABASE_URL=https://pksaqwmgibkuyydlwdfb.supabase.co
CLAUDE_MODEL=claude-opus-5
CORS_ORIGINS=http://localhost:3000

# Optional: Claude through Microsoft Foundry instead of the Claude API.
# CLAUDE_MODEL then names your Foundry deployment.
# CLAUDE_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_RESOURCE=<your-foundry-resource-name>
# ANTHROPIC_FOUNDRY_API_KEY=
# CLAUDE_FALLBACK_MODEL=<a second deployment, e.g. of claude-opus-4-8, used if a request is refused>
